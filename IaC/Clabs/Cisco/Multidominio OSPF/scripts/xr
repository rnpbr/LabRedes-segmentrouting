#!/usr/bin/env python3
import os
import re
import select
import subprocess
import sys
import time
import tty


PROMPT_RE = re.compile(rb"RP/.+?#")


def read_until(fd, patterns, timeout=60):
    data = bytearray()
    deadline = time.time() + timeout
    while time.time() < deadline:
        readable, _, _ = select.select([fd], [], [], 0.2)
        if not readable:
            continue
        try:
            chunk = os.read(fd, 4096)
        except OSError:
            break
        if not chunk:
            break
        data.extend(chunk)
        if b"--More--" in data:
            os.write(fd, b" ")
            data = data.replace(b"--More--", b"")
        for pattern in patterns:
            if isinstance(pattern, bytes):
                if pattern in data:
                    return bytes(data)
            elif pattern.search(data):
                return bytes(data)
    raise TimeoutError(data.decode(errors="replace"))


def clean_output(raw):
    text = raw.decode(errors="replace")
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    text = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", text)
    text = text.replace("\b", "")
    lines = []
    for line in text.splitlines():
        if "RP/0/RP0/CPU0:" in line and "#" in line:
            continue
        if line.strip() in {"terminal length 0", "terminal width 512"}:
            continue
        lines.append(line.rstrip())
    return "\n".join(lines).strip()


def run(container, commands):
    master, slave = os.openpty()
    tty.setraw(slave)
    try:
        proc = subprocess.Popen(
            ["docker", "exec", "-it", container, "/pkg/bin/xr_cli.sh"],
            stdin=slave,
            stdout=slave,
            stderr=slave,
            close_fds=True,
        )
        os.close(slave)
        read_until(master, [b"Username:"], timeout=90)
        os.write(master, b"clab\r")
        read_until(master, [b"Password:"], timeout=30)
        os.write(master, b"clab@123\r")
        read_until(master, [PROMPT_RE], timeout=90)
        for setup in ("terminal length 0", "terminal width 512"):
            os.write(master, setup.encode() + b"\r")
            read_until(master, [PROMPT_RE], timeout=30)
        outputs = []
        for command in commands:
            os.write(master, command.encode() + b"\r")
            raw = read_until(master, [PROMPT_RE], timeout=60)
            output = clean_output(raw)
            if output.splitlines()[:1] == [command]:
                output = "\n".join(output.splitlines()[1:]).strip()
            outputs.append((command, output))
        os.write(master, b"exit\r")
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.terminate()
        return outputs
    finally:
        try:
            os.close(master)
        except OSError:
            pass


def main():
    if len(sys.argv) < 3:
        print("usage: scripts/xr <node-or-container> <command> [<command> ...]", file=sys.stderr)
        return 2
    node = sys.argv[1]
    container = node if node.startswith("clab-") else f"clab-flex-algo-anycast-{node}"
    outputs = run(container, sys.argv[2:])
    for idx, (command, output) in enumerate(outputs):
        if idx:
            print()
        print(f"$ {command}")
        if output:
            print(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
